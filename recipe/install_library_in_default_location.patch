Install library in default location

Drop the hardcoded "DESTINATION lib" so CMake uses its default install
destinations (on Windows the DLLs then go to bin). Originally by Silvio
Traversaro, refreshed for asl 1.0.2.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index e6a34bd..dd08f7d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -519,7 +519,7 @@ if(NOT ASL_SKIP_INSTALL)
   set(asl_targets asl asl2 asl-mt asl2-mt asl-dynrt asl2-dynrt)
   foreach(target ${asl_targets})
     if(TARGET ${target})
-      install(TARGETS ${target} EXPORT ampl-asl-config DESTINATION lib COMPONENT asl)
+      install(TARGETS ${target} EXPORT ampl-asl-config COMPONENT asl)
     endif()
   endforeach()
 
